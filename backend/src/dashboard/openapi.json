{
  "openapi": "3.1.0",
  "info": {
    "title": "Savings Wallet — Dashboard API",
    "version": "1.0.0",
    "description": "Panel de gastos del usuario conectado a belo. Solo lectura: no mueve fondos.\n\nLa respuesta tiene la forma de `mocks/mock-transactions.json`, construida desde los movimientos de belo (ledger + tarjetas).\n\n**Origen de los datos**\n- Si el servidor corre con `BELO_DEMO_PROFILE` (`family`, `salaried`, `erratic`, `short_history`), devuelve ese perfil sintético y no requiere credencial.\n- Si no, usa la cuenta belo del header `X-Belo-Api-Key`.\n\n**Montos**: números JSON. `amount` en la moneda original; `amountArs` en pesos (cotización del día guardada con los datos), `null` si no hay cotización."
  },
  "servers": [
    { "url": "/", "description": "Este servidor" },
    { "url": "http://127.0.0.1:8000", "description": "Local (uvicorn)" }
  ],
  "tags": [{ "name": "dashboard", "description": "Panel de gastos" }],
  "paths": {
    "/api/dashboard/transactions": {
      "get": {
        "tags": ["dashboard"],
        "operationId": "getDashboardTransactions",
        "summary": "Movimientos del usuario para el panel de gastos",
        "description": "Ingresos (`credit`) y gastos (`debit`) de los últimos 180 días, ordenados del más viejo al más nuevo, con cuentas y totales. No incluye transferencias entre cuentas propias ni movimientos pendientes o fallidos.",
        "security": [{ "BeloApiKey": [] }, {}],
        "responses": {
          "200": {
            "description": "Movimientos, cuentas y totales",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TransactionsResponse" }
              }
            }
          },
          "401": {
            "description": "Falta la credencial o no da acceso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "missing_credential": {
                    "value": { "error": { "code": "missing_credential", "message": "Conectá tu cuenta belo (header X-Belo-Api-Key)." } }
                  },
                  "unauthorized": {
                    "value": { "error": { "code": "unauthorized", "message": "Tu cuenta belo no dio acceso a los datos necesarios." } }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Perfil demo mal configurado en el servidor",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": { "code": "unknown_demo_profile", "message": "Perfil demo desconocido 'x'. Opciones: salaried, erratic, short_history, family" } }
              }
            }
          },
          "502": {
            "description": "belo no respondió",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": { "code": "upstream_error", "message": "No pudimos leer tus datos de belo en este momento." } }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BeloApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Belo-Api-Key",
        "description": "API key de belo del usuario (`belo_live_...`). No hace falta con un perfil demo activo."
      }
    },
    "schemas": {
      "TransactionsResponse": {
        "type": "object",
        "required": ["version", "generatedAt", "profile", "accounts", "transactions", "dateRange", "stats"],
        "properties": {
          "version": { "type": "string", "examples": ["1.0.0"] },
          "generatedAt": { "type": "string", "format": "date-time" },
          "profile": { "$ref": "#/components/schemas/Profile" },
          "accounts": { "type": "array", "items": { "$ref": "#/components/schemas/Account" } },
          "transactions": { "type": "array", "items": { "$ref": "#/components/schemas/Transaction" } },
          "dateRange": { "$ref": "#/components/schemas/DateRange" },
          "stats": { "$ref": "#/components/schemas/Stats" }
        }
      },
      "Profile": {
        "type": "object",
        "description": "Solo datos derivados de los movimientos; no se inventan datos personales.",
        "required": ["id", "name", "familyMembers", "employment", "location"],
        "properties": {
          "id": { "type": "string", "description": "Hash del titular (`demo-<perfil>` en modo demo). Nunca la credencial.", "examples": ["demo-family"] },
          "name": { "type": ["string", "null"], "description": "Nombre visible. `null` para usuarios reales (belo no lo expone).", "examples": ["Usuario demo · Familia"] },
          "familyMembers": { "type": "array", "items": { "$ref": "#/components/schemas/FamilyMember" }, "description": "Siempre vacío por ahora." },
          "employment": {
            "oneOf": [{ "$ref": "#/components/schemas/Employment" }, { "type": "null" }],
            "description": "Derivado de un ingreso recurrente (mismo pagador en ≥ 3 meses). `null` si no hay sueldo detectado."
          },
          "location": {
            "oneOf": [{ "$ref": "#/components/schemas/Location" }, { "type": "null" }],
            "description": "Siempre `null` por ahora."
          }
        }
      },
      "FamilyMember": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "relationship": { "type": "string", "examples": ["spouse", "child"] },
          "birthDate": { "type": "string", "format": "date" }
        }
      },
      "Employment": {
        "type": "object",
        "required": ["type", "company", "position", "monthlySalary", "payDay"],
        "properties": {
          "type": { "type": "string", "examples": ["empleado"] },
          "company": { "type": ["string", "null"], "description": "Nombre del pagador del sueldo", "examples": ["Tech Solutions SA"] },
          "position": { "type": ["string", "null"], "description": "Siempre `null` (no se deriva)." },
          "monthlySalary": { "type": "integer", "description": "Mediana del sueldo en ARS", "examples": [2800000] },
          "payDay": { "type": "integer", "minimum": 1, "maximum": 31, "description": "Día de cobro más frecuente", "examples": [5] }
        }
      },
      "Location": {
        "type": "object",
        "properties": {
          "city": { "type": "string" },
          "province": { "type": "string" }
        }
      },
      "Account": {
        "type": "object",
        "required": ["id", "type", "name", "currency", "balance"],
        "properties": {
          "id": { "type": "string", "examples": ["balance-ARGt", "vault-demo-vault-vacaciones"] },
          "type": { "type": "string", "enum": ["checking", "crypto", "savings"], "description": "`checking` = pesos, `crypto` = cripto/stablecoins, `savings` = vault" },
          "name": { "type": "string", "examples": ["Cuenta Belo", "Wallet USDT", "Vacaciones"] },
          "currency": { "type": "string", "description": "ARGt se informa como ARS y BRAt como BRL", "examples": ["ARS", "USDT", "BTC"] },
          "balance": { "$ref": "#/components/schemas/Balance" }
        }
      },
      "Balance": {
        "type": "object",
        "required": ["currency", "available", "updatedAt"],
        "properties": {
          "currency": { "type": "string" },
          "available": { "type": "number", "examples": [1850000] },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Transaction": {
        "type": "object",
        "required": ["id", "type", "category", "amount", "currency", "amountArs", "description", "method", "createdAt", "merchant"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["debit", "credit"], "description": "`credit` = ingreso, `debit` = gasto" },
          "category": {
            "type": "string",
            "description": "Vocabulario de `mock-transactions.json`, asignado por palabra clave en comercio/contraparte.\n\n- Ingresos: `salario`, `freelance`, `reembolso`, `aguinaldo`, `venta_crypto`.\n- Gastos: `alquiler`, `expensas`, `luz`, `gas`, `agua`, `internet`, `telefono`, `cuota_colegio`, `debito_prepaga`, `debito_gimnasio`, `debito_netflix`, `debito_spotify`, `debito_streaming`, `tarjeta_supermercado`, `tarjeta_combustible`, `tarjeta_restaurante`, `tarjeta_farmacia`, `tarjeta_indumentaria`, `tarjeta_tecnologia`, `uber_taxi`, `peaje`, `seguro_auto`, `impuesto_ganancias`, `compra_crypto`.\n- Sin coincidencia (no están en el mock): `transferencia_recibida`, `deposito_crypto`, `transferencia_enviada`, `tarjeta_otros`, `pix_enviado`, `retiro_crypto`.",
            "examples": ["tarjeta_supermercado", "salario", "alquiler"]
          },
          "amount": { "type": "number", "description": "Monto en la moneda original. En gastos incluye fee e impuestos." },
          "currency": { "type": "string", "examples": ["ARS", "USDT"] },
          "amountArs": { "type": ["integer", "null"], "description": "Monto en ARS redondeado. `null` si no hay cotización para esa fecha." },
          "description": { "type": "string", "examples": ["Transferencia a Inmobiliaria Palermo", "JUMBO", "Compra de USDT"] },
          "method": { "type": "string", "enum": ["debito_automatico", "tarjeta_credito", "tarjeta_debito", "transferencia", "crypto", "plazo_fijo"], "description": "Hoy se emiten `tarjeta_debito` (tarjeta belo), `transferencia` y `crypto`." },
          "createdAt": { "type": "string", "format": "date-time" },
          "merchant": { "type": "string", "examples": ["JUMBO", "Tech Solutions SA"] },
          "card": { "$ref": "#/components/schemas/CardInfo" },
          "crypto": { "$ref": "#/components/schemas/CryptoInfo" },
          "investment": { "$ref": "#/components/schemas/InvestmentInfo" }
        }
      },
      "CardInfo": {
        "type": "object",
        "description": "Solo en consumos con tarjeta",
        "properties": {
          "last4": { "type": ["string", "null"], "examples": ["4532"] },
          "brand": { "type": ["string", "null"], "examples": ["visa"] }
        }
      },
      "CryptoInfo": {
        "type": "object",
        "description": "Solo en compras/ventas de cripto (swaps)",
        "properties": {
          "asset": { "type": ["string", "null"], "examples": ["USDT"] },
          "amount": { "type": ["number", "null"], "description": "Cantidad del activo" },
          "priceArs": { "type": ["number", "null"], "description": "Precio de 1 unidad en ARS" }
        }
      },
      "InvestmentInfo": {
        "type": "object",
        "description": "Presente en el mock (plazo fijo); hoy no se emite.",
        "properties": {
          "type": { "type": "string" },
          "rate": { "type": "number" },
          "maturityDate": { "type": "string", "format": "date" }
        }
      },
      "DateRange": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "format": "date" },
          "to": { "type": "string", "format": "date" }
        }
      },
      "Stats": {
        "type": "object",
        "required": ["totalTransactions", "totalIncome", "totalExpenses", "averageMonthlyIncome", "averageMonthlyExpenses"],
        "description": "Totales en ARS sobre `transactions`. Los promedios dividen por los meses con movimientos (incluye el mes en curso).",
        "properties": {
          "totalTransactions": { "type": "integer" },
          "totalIncome": { "type": "integer" },
          "totalExpenses": { "type": "integer" },
          "averageMonthlyIncome": { "type": "integer" },
          "averageMonthlyExpenses": { "type": "integer" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "enum": ["missing_credential", "unauthorized", "upstream_error", "unknown_demo_profile"] },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
