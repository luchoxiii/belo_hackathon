SALDO_INICIAL=100000
TASA_WALLET_ANUAL=0.20
GASTOS_MENSUALES=50000

# API de belo (read-only)
BELO_API_KEY=belo_live_<your-key>
BELO_API_BASE_URL=https://<belo-api-host>
BELO_API_TIMEOUT=5

# Rangos declarados para scoring (la API no los devuelve en GET /cards/application)
# annual: from_0_to_5000 | from_5000_to_10000 | from_10000_to_20000 | from_20000_to_50000 | from_50000_to_100000 | more_than_100000
# card:   from_0_to_500 | from_500_to_1000 | from_1000_to_5000 | from_5000_to_10000 | more_than_10000
BELO_DECLARED_ANNUAL_REVENUE=
BELO_DECLARED_MONTHLY_CARD_SPEND=

# Cotización ARS/USD histórica (argentinadatos): oficial | bolsa (MEP) | blue
BELO_FX_ARS_CASA=oficial

# Oferta preaprobada (placeholders de negocio)
LOAN_MIN_USD=50
LOAN_MAX_USD=2000

# Solo demo: si la conexión MCP no manda X-Belo-Api-Key, usar BELO_API_KEY del servidor
BELO_ALLOW_SERVER_CREDENTIAL=false

# Solo demo: perfil sintético para las tools de crédito (salaried | erratic | short_history)
# Con esto activo no se usa la credencial ni se llama a belo. Nunca en producción.
BELO_DEMO_PROFILE=
